---
/**
 * The footer: the same destinations as the top of the page, plus the guides
 * and the API reference, who to write to, and who the legal sender is (O1).
 *
 * Privacy and terms are not linked yet: the counsel-reviewed texts are not
 * approved, and the prompt's rule is that the pages do not go live until
 * they are. A footer link to a page that answers 404 is worse than none.
 */
import Mark from "@/components/site/Mark.astro";
import { APP, AUDIENCE_PAGES, PRIMARY_NAV, PRODUCT_PAGES, SITE } from "@/lib/site";

const columns = [
  { heading: "Product", links: PRODUCT_PAGES.map(({ href, label }) => ({ href, label })) },
  { heading: "Who it is for", links: AUDIENCE_PAGES },
  {
    heading: "Learn",
    links: [
      ...PRIMARY_NAV,
      { href: APP.guides, label: "Guides" },
      { href: APP.apiReference, label: "API reference" },
    ],
  },
  {
    heading: "Account",
    links: [
      { href: APP.signIn, label: "Sign in" },
      { href: APP.partnerSignIn, label: "Partner sign in" },
      { href: APP.register, label: "Start free" },
    ],
  },
];
---

<footer class="border-t border-border bg-canvas">
  <div class="mx-auto w-full max-w-marketing px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-[1.4fr_repeat(4,1fr)]">
      <div class="max-w-xs">
        <span class="inline-flex items-center gap-2 text-ink">
          <Mark size={28} />
          <span class="text-heading-md font-semibold tracking-tight">Refficks</span>
        </span>
        <p class="mt-3 text-meta text-ink-secondary">
          Partner Growth OS. Tracking, attribution, commissions and payouts, and every morning the
          partners who need you, with the evidence.
        </p>
        <p class="mt-4 text-meta text-ink-secondary">
          <a href={`mailto:${SITE.supportEmail}`} class="text-link hover:underline">{SITE.supportEmail}</a>
          <br />
          {SITE.legalName}
        </p>
      </div>

      {
        columns.map((column) => (
          <div>
            <p class="text-label font-semibold uppercase text-ink-secondary">{column.heading}</p>
            <ul class="mt-3 flex flex-col gap-2">
              {column.links.map((item) => (
                <li>
                  <a href={item.href} class="text-meta text-ink-secondary transition-colors hover:text-ink">
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <p class="mt-10 border-t border-border pt-6 text-caption text-ink-secondary">
      Hosted in the EU. No cookies on this site, so there is nothing to ask you to accept.
    </p>
  </div>
</footer>
