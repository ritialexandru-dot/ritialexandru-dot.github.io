---
/**
 * A real product screenshot in a browser frame: a title bar with three dots
 * and the product's address, then the capture at its own size. The image
 * carries its dimensions so the page does not move when it arrives, offers
 * a 2x file to screens that can show it, and is lazy below the fold.
 *
 * `narrow` names a tighter crop of the same screen for phones, where a
 * 1176px capture would shrink to a third and could not be read.
 */
import type { Shot } from "@/lib/shots";

interface Props extends Shot {
  narrow?: Shot;
  priority?: boolean;
  address?: string;
  class?: string;
}

const {
  src,
  alt,
  width,
  height,
  narrow,
  priority = false,
  address = "app.refficks.com",
  class: className = "",
} = Astro.props;

const twoX = (file: string) => file.replace(/\.webp$/, "@2x.webp");
---

<div class:list={["overflow-hidden rounded-xl border border-border bg-surface", className]}>
  <div class="flex items-center gap-3 border-b border-border bg-subtle px-3 py-2">
    <span class="flex gap-1.5" aria-hidden="true">
      <span class="size-2.5 rounded-full bg-border-strong"></span>
      <span class="size-2.5 rounded-full bg-border-strong"></span>
      <span class="size-2.5 rounded-full bg-border-strong"></span>
    </span>
    <span class="mx-auto rounded-md bg-surface px-3 py-0.5 text-label text-ink-secondary" aria-hidden="true">
      {address}
    </span>
    <span class="w-10" aria-hidden="true"></span>
  </div>
  <picture>
    {
      narrow && (
        <source
          media="(max-width: 639px)"
          srcset={`${narrow.src} 1x, ${twoX(narrow.src)} 2x`}
          width={narrow.width}
          height={narrow.height}
        />
      )
    }
    <img
      src={src}
      srcset={`${src} 1x, ${twoX(src)} 2x`}
      alt={alt}
      width={width}
      height={height}
      class="block h-auto w-full"
      loading={priority ? "eager" : "lazy"}
      decoding={priority ? "sync" : "async"}
      fetchpriority={priority ? "high" : "auto"}
    />
  </picture>
</div>
