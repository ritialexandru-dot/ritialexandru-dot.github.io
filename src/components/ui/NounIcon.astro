---
/**
 * The design kit's custom icons for the product's own nouns, drawn on the
 * 20px grid at 1.5px stroke: the drop tile upper left, the subject lower
 * right. They inherit `currentColor`, and the generic set covers the rest.
 */
interface Props {
  name:
    | "link"
    | "attribution"
    | "commission"
    | "payout"
    | "partner"
    | "integration"
    | "tile"
    | "creator"
    | "coupon"
    | "conversion"
    | "report"
    | "programme"
    | "ambassador"
    | "fraud"
    | "monitor";
  size?: number;
  class?: string;
}

const { name, size = 24, class: className = "" } = Astro.props;

const TILE = '<path d="M3.5 3.5H10a6.5 6.5 0 1 1-6.5 6.5z"/>';
const SMALL_TILE = '<path d="M3.5 3.5H9a5.5 5.5 0 1 1-5.5 5.5z"/>';

const ICONS: Record<Props["name"], string> = {
  link: `${SMALL_TILE}<path d="M11 14l3.5-3.5M10 17a2.8 2.8 0 0 1 0-4l1-1M17 10a2.8 2.8 0 0 1 0 4l-1 1"/>`,
  attribution: '<path d="M3.5 3.5H8a4.5 4.5 0 1 1-4.5 4.5z"/><circle cx="15" cy="15" r="2.5"/><path d="M8 8l4.9 4.9"/>',
  commission: `${TILE}<path d="M12.5 12.5l4-4"/><circle cx="12.5" cy="12.5" r="1" fill="currentColor" stroke="none"/><circle cx="16.5" cy="8.5" r="1" fill="currentColor" stroke="none"/><path d="M11.5 17.5h6"/>`,
  payout: `${TILE}<path d="M13 17h4.5v-4.5M17.5 17L11 10.5"/>`,
  partner: `${SMALL_TILE}<path d="M16.5 16.5H11A5.5 5.5 0 1 1 16.5 11z"/>`,
  integration: `${SMALL_TILE}<path d="M16.5 16.5H11A5.5 5.5 0 1 1 16.5 11z"/><path d="M9 9l2 2"/>`,
  tile: TILE,
  creator: `${TILE}<path d="M13 3.5l.9 2.1 2.1.9-2.1.9-.9 2.1-.9-2.1-2.1-.9 2.1-.9z" fill="currentColor" stroke="none"/><path d="M13.5 17.5h4"/>`,
  coupon: `${TILE}<path d="M11.5 12.5h6v5h-6zM11.5 15h6" stroke-dasharray="1.5 1.5"/>`,
  conversion: `${TILE}<path d="M12 12l5.5 2-2.4 1-1 2.4z"/>`,
  report: `${SMALL_TILE}<path d="M11.5 16.5v-4M14.5 16.5V9M17.5 16.5v-6M3.5 16.5h5"/>`,
  programme:
    '<path d="M3.5 3.5h5.5a5.5 5.5 0 1 1-5.5 5.5z"/><path d="M11 5.5h5.5M11 8.5h4M3.5 12.5h5.5M3.5 15.5h4M11 16.5V11A5.5 5.5 0 1 1 16.5 16.5z"/>',
  ambassador: `${TILE}<path d="M10 13v4.5M6.5 17.5h7"/>`,
  fraud: `${TILE}<circle cx="10" cy="10" r="1.75" fill="currentColor" stroke="none"/><path d="M15 11.5l2.5 1v2.2c0 1.6-1 2.9-2.5 3.6-1.5-.7-2.5-2-2.5-3.6v-2.2z"/>`,
  monitor: `<path d="M3.5 3.5H10A6.5 6.5 0 1 1 3.5 10z"/><circle cx="10" cy="10" r="1.75" fill="currentColor" stroke="none"/><path d="M13.5 16.5h3v-3"/>`,
};
---

<svg
  viewBox="0 0 20 20"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={className}
  set:html={ICONS[name]}
/>
