---
/**
 * The design kit's custom icons for the product's own nouns, drawn on the
 * 20px grid at 1.5px stroke: the drop tile upper left, the subject lower
 * right. They inherit `currentColor`, and Lucide covers everything generic.
 */
interface Props {
  name: "link" | "attribution" | "commission" | "payout" | "partner" | "integration" | "tile";
  size?: number;
  class?: string;
}

const { name, size = 24, class: className = "" } = Astro.props;
---

<svg
  viewBox="0 0 20 20"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={className}
>
  {
    name === "link" && (
      <>
        <path d="M3.5 3.5H9a5.5 5.5 0 1 1-5.5 5.5z" />
        <path d="M11 14l3.5-3.5M10 17a2.8 2.8 0 0 1 0-4l1-1M17 10a2.8 2.8 0 0 1 0 4l-1 1" />
      </>
    )
  }
  {
    name === "attribution" && (
      <>
        <path d="M3.5 3.5H8a4.5 4.5 0 1 1-4.5 4.5z" />
        <circle cx="15" cy="15" r="2.5" />
        <path d="M8 8l4.9 4.9" />
      </>
    )
  }
  {
    name === "commission" && (
      <>
        <path d="M3.5 3.5H10a6.5 6.5 0 1 1-6.5 6.5z" />
        <path d="M12.5 12.5l4-4" />
        <circle cx="12.5" cy="12.5" r="1" fill="currentColor" stroke="none" />
        <circle cx="16.5" cy="8.5" r="1" fill="currentColor" stroke="none" />
        <path d="M11.5 17.5h6" />
      </>
    )
  }
  {
    name === "payout" && (
      <>
        <path d="M3.5 3.5H10a6.5 6.5 0 1 1-6.5 6.5z" />
        <path d="M13 17h4.5v-4.5M17.5 17L11 10.5" />
      </>
    )
  }
  {
    name === "partner" && (
      <>
        <path d="M3.5 3.5H9a5.5 5.5 0 1 1-5.5 5.5z" />
        <path d="M16.5 16.5H11A5.5 5.5 0 1 1 16.5 11z" />
      </>
    )
  }
  {
    name === "integration" && (
      <>
        <path d="M3.5 3.5H9a5.5 5.5 0 1 1-5.5 5.5z" />
        <path d="M16.5 16.5H11A5.5 5.5 0 1 1 16.5 11z" />
        <path d="M9 9l2 2" />
      </>
    )
  }
  {name === "tile" && <path d="M3.5 3.5H10a6.5 6.5 0 1 1-6.5 6.5z" />}
</svg>
