---
/**
 * The few generic icons the site needs, from Lucide (ISC), drawn at the
 * kit's 1.5px stroke with round caps and joins. Inlined rather than taken
 * from a package, because five paths do not need a dependency.
 */
interface Props {
  name: "chevron-down" | "menu" | "x" | "arrow-right" | "check";
  class?: string;
  strokeWidth?: number;
}

const { name, class: className = "size-4", strokeWidth = 1.5 } = Astro.props;

const PATHS: Record<Props["name"], string[]> = {
  "chevron-down": ["m6 9 6 6 6-6"],
  menu: ["M4 6h16", "M4 12h16", "M4 18h16"],
  x: ["M18 6 6 18", "m6 6 12 12"],
  "arrow-right": ["M5 12h14", "m12 5 7 7-7 7"],
  check: ["M20 6 9 17l-5-5"],
};
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={className}
>
  {PATHS[name].map((d) => <path d={d} />)}
</svg>
