---
/**
 * The generic icons the site needs: the design kit's own Lucide-style set
 * on the 20px grid at 1.5px stroke with round caps and joins, plus five
 * Lucide paths on the 24px grid. Inlined rather than taken from a package,
 * because a handful of paths does not need a dependency.
 */
interface Props {
  name:
    | "chevron-down"
    | "menu"
    | "x"
    | "arrow-right"
    | "check"
    | "lock"
    | "shield"
    | "undo"
    | "sparkle"
    | "globe"
    | "download"
    | "users"
    | "trash"
    | "send"
    | "mail"
    | "percent"
    | "bar-chart"
    | "refresh"
    | "building"
    | "credit-card";
  class?: string;
  strokeWidth?: number;
}

const { name, class: className = "size-4", strokeWidth = 1.5 } = Astro.props;

const ICONS: Record<Props["name"], { box: 20 | 24; markup: string }> = {
  "chevron-down": { box: 24, markup: '<path d="m6 9 6 6 6-6"/>' },
  menu: { box: 24, markup: '<path d="M4 6h16"/><path d="M4 12h16"/><path d="M4 18h16"/>' },
  x: { box: 24, markup: '<path d="M18 6 6 18"/><path d="m6 6 12 12"/>' },
  "arrow-right": { box: 24, markup: '<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>' },
  check: { box: 24, markup: '<path d="M20 6 9 17l-5-5"/>' },
  lock: {
    box: 20,
    markup: '<rect x="4.5" y="9" width="11" height="8" rx="2"/><path d="M7 9V6.5a3 3 0 0 1 6 0V9"/>',
  },
  shield: {
    box: 20,
    markup: '<path d="M10 2.5l6 2.2v4.6c0 3.7-2.4 6.6-6 8.2-3.6-1.6-6-4.5-6-8.2V4.7z"/>',
  },
  undo: { box: 20, markup: '<path d="M7.5 5.5L3.5 9l4 3.5M3.5 9h8a5 5 0 0 1 0 10"/>' },
  sparkle: {
    box: 20,
    markup:
      '<path d="M9 3l1.5 4 4 1.5-4 1.5L9 14l-1.5-4L3.5 8.5l4-1.5zM15.5 13l.7 1.8 1.8.7-1.8.7-.7 1.8-.7-1.8-1.8-.7 1.8-.7z"/>',
  },
  globe: {
    box: 20,
    markup: '<circle cx="10" cy="10" r="7"/><path d="M3 10h14M10 3c2.5 2.5 2.5 11.5 0 14M10 3c-2.5 2.5-2.5 11.5 0 14"/>',
  },
  download: { box: 20, markup: '<path d="M10 3v10M6 9l4 4 4-4M3.5 16.5h13"/>' },
  users: {
    box: 20,
    markup:
      '<circle cx="7.5" cy="7" r="3"/><path d="M2.5 17c0-2.8 2.2-5 5-5s5 2.2 5 5M13 4.2a3 3 0 0 1 0 5.6M17.5 17c0-2.3-1.5-4.2-3.5-4.8"/>',
  },
  trash: {
    box: 20,
    markup: '<path d="M3.5 5.5h13M8 5.5V4h4v1.5M5 5.5l.8 10.5h8.4l.8-10.5M8.5 9v4M11.5 9v4"/>',
  },
  send: { box: 20, markup: '<path d="M17 3L9 11M17 3l-5 14-3-6-6-3z"/>' },
  mail: {
    box: 20,
    markup: '<rect x="2.5" y="4.5" width="15" height="11" rx="2"/><path d="M2.5 7l7.5 5 7.5-5"/>',
  },
  percent: {
    box: 20,
    markup: '<path d="M15.5 4.5l-11 11"/><circle cx="6.5" cy="6.5" r="2"/><circle cx="13.5" cy="13.5" r="2"/>',
  },
  "bar-chart": { box: 20, markup: '<path d="M4.5 16.5v-6M10 16.5V3.5M15.5 16.5v-9"/>' },
  refresh: {
    box: 20,
    markup:
      '<path d="M16.5 8A6.5 6.5 0 0 0 4.7 6.2M3.5 3.5v3.5H7M3.5 12a6.5 6.5 0 0 0 11.8 1.8M16.5 16.5V13H13"/>',
  },
  building: {
    box: 20,
    markup:
      '<rect x="3.5" y="3.5" width="13" height="14" rx="1"/><path d="M7 7h2M11 7h2M7 10.5h2M11 10.5h2M8.5 17.5v-3h3v3"/>',
  },
  "credit-card": {
    box: 20,
    markup: '<rect x="2.5" y="5" width="15" height="11" rx="2"/><path d="M2.5 9h15M6 12.5h3"/>',
  },
};

const icon = ICONS[name];
---

<svg
  viewBox={`0 0 ${icon.box} ${icon.box}`}
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={className}
  set:html={icon.markup}
/>
