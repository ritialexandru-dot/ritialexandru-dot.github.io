---
/**
 * The social-proof substitute (prompt §7): no customers to quote, so the
 * product's own sentences, each one on a screen in the app today. Every
 * string here was verified against the app's source on 8 October; the one
 * em dash is inside a verbatim quote and stays as the product prints it.
 */
import Container from "@/components/site/Container.astro";
import Section from "@/components/site/Section.astro";
import SectionHeading from "@/components/site/SectionHeading.astro";

const QUOTES = [
  {
    said: "Approved 29 days ago and has not sent a single click.",
    where: "The Needs you list, on a partner worth a nudge",
  },
  {
    said: "Ranked by what it costs you to ignore. Every one shows its evidence.",
    where: "The Needs you tab",
  },
  {
    said: "1 other partner had a live claim on this customer, which is why confidence is below full.",
    where: "Why this conversion was attributed",
  },
  {
    said: "20% of USD 299.00",
    where: "A commission entry. The arithmetic it was written with, stored beside it.",
  },
  {
    said: "No earlier period to compare",
    where: "The overview in a first month, where other products print +100%",
  },
  {
    said: "Review recommended",
    where: "A risk finding. Never “fraud detected”, and there is no apply button on it, by design.",
  },
  {
    said: "Things that happened after — never proof that acting caused them.",
    where: "The Results tab, 30 days after you acted on a recommendation",
  },
  {
    said: "Written by AI",
    where: "On every sentence the assistant writes, with the model named",
  },
];
---

<Section tone="canvas" labelledBy="own-words-heading">
  <Container>
    <SectionHeading
      id="own-words-heading"
      title="No customer quotes yet. Here is what the product says instead."
      lead="Refficks is new, and there is nobody to quote. We would rather show you the product's own sentences than invent a person to say them. Every line below is on a screen in the app today, written to be read by people whose money depends on it."
    />

    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        QUOTES.map((quote) => (
          <li>
            <blockquote class="flex h-full flex-col rounded-lg border border-border bg-surface p-5">
              <p class="text-heading-md font-semibold text-ink" data-numeric>
                “{quote.said}”
              </p>
              <footer class="mt-auto pt-4 text-meta text-ink-secondary">{quote.where}</footer>
            </blockquote>
          </li>
        ))
      }
    </ul>

    <p class="mt-8 max-w-3xl text-body text-ink-secondary">
      A page of real screens is our proof the product exists. The rest you can check yourself, free,
      for 30 days.
    </p>
  </Container>
</Section>
