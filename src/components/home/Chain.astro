---
/** The whole chain under the morning (Home 5), one card per link. */
import Container from "@/components/site/Container.astro";
import Section from "@/components/site/Section.astro";
import SectionHeading from "@/components/site/SectionHeading.astro";
import Button from "@/components/ui/Button.astro";
import NounIcon from "@/components/ui/NounIcon.astro";
import Precisely from "@/components/ui/Precisely.astro";

const LINKS = [
  {
    icon: "link",
    title: "Tracking",
    body: "Partners get links and coupon codes, and a code credits a partner even when nobody clicked. One script tag on your site, a no-code install for Shopify, WooCommerce and BigCommerce, or a Stripe connection that needs no JavaScript at all.",
    precisely:
      "the publishable key in the script tag can record visits and identify customers. It cannot read anything, and it refuses revenue. Secret keys live on your server.",
  },
  {
    icon: "attribution",
    title: "Attribution",
    body: "Last-touch by default, first-touch if you choose, across the programme's window. Every decision is stored with every touch considered, which won, which lost and why, and how sure it is. A sale nobody earned is recorded as exactly that, not dropped.",
    precisely:
      "30 days unless set otherwise, 60 for referral programmes. Corrections supersede; they never overwrite. Before you change a rule, Refficks shows what it would have done to up to 1,000 past sales. Nothing is written.",
  },
  {
    icon: "commission",
    title: "Commissions",
    body: "A percentage or a flat amount, once or on every renewal, for a number of months or for as long as the customer pays. Every entry stores the arithmetic that made it. A refund writes a reversal beside the original rather than editing it.",
    precisely:
      "money is integer minor units plus an ISO currency, everywhere. Yen stay yen. Every total is per currency, and nothing adds euros to dollars.",
  },
  {
    icon: "payout",
    title: "Payouts",
    body: "The preview shows who is owed, who cannot be paid and exactly why, before anything is committed. Then a file to pay from, or PayPal payouts from your own balance, each on a named button, one press per decision, never twice.",
    precisely:
      "partners' payout details are encrypted at rest and shown on no screen, to anyone, including the partner who typed them. Each time they leave Refficks, it is recorded.",
  },
  {
    icon: "partner",
    title: "The partner portal",
    body: "One sign-in across every merchant a partner works with, built for a phone: their clicks, sales, payouts, statements, and the same commission arithmetic you see.",
    precisely:
      "it can run on your own domain, with HTTPS issued automatically, in your logo, colours and wording.",
  },
] as const;
---

<Section tone="canvas" labelledBy="chain-heading">
  <Container>
    <SectionHeading
      id="chain-heading"
      eyebrow="From click to payout"
      title="Underneath the morning: the whole chain, and every link in it explains itself"
    />

    <ul class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {
        LINKS.map((item) => (
          <li class="flex flex-col rounded-lg border border-border bg-surface p-6">
            <span class="inline-flex size-12 items-center justify-center rounded-md rounded-tl-xs bg-brand-tint text-icon-brand">
              <NounIcon name={item.icon} size={24} />
            </span>
            <h3 class="mt-4 text-heading-lg font-semibold text-ink">{item.title}</h3>
            <p class="mt-2 text-body-sm text-ink-secondary">{item.body}</p>
            <Precisely class="mt-4">{item.precisely}</Precisely>
          </li>
        ))
      }
      <li class="flex flex-col justify-center rounded-lg border border-dashed border-border-strong p-6">
        <p class="text-body-sm text-ink-secondary">
          Each link has its own page, with the screens and the refusals that go with it.
        </p>
        <div class="mt-4">
          <Button href="/product/tracking/" variant="secondary" size="md">See how it works</Button>
        </div>
      </li>
    </ul>
  </Container>
</Section>
