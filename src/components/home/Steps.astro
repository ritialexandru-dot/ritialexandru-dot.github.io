---
/** How a programme starts, in three numbered steps. */
import Container from "@/components/site/Container.astro";
import Section from "@/components/site/Section.astro";
import SectionHeading from "@/components/site/SectionHeading.astro";

const STEPS = [
  {
    title: "Connect where you sell",
    body: "Stripe, Shopify, WooCommerce or BigCommerce, or paste one script tag on your site.",
  },
  {
    title: "Set a commission plan",
    body: "A percentage or a flat amount, once or on every renewal, for as long as you choose.",
  },
  {
    title: "Invite your partners",
    body: "They get links, codes and a portal. The first sale arrives with its reasoning attached.",
  },
];
---

<Section tone="canvas" labelledBy="steps-heading">
  <Container>
    <SectionHeading id="steps-heading" align="center" title="Up and running in three steps" />

    <ol class="mt-12 grid gap-5 md:grid-cols-3">
      {
        STEPS.map((step, index) => (
          <li class="rounded-xl border border-border bg-surface p-6">
            <span class="text-display-md font-bold text-icon-brand" data-numeric>
              {String(index + 1).padStart(2, "0")}
            </span>
            <h3 class="mt-3 text-heading-lg font-semibold text-ink">{step.title}</h3>
            <p class="mt-2 text-body-sm text-ink-secondary">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </Container>
</Section>
