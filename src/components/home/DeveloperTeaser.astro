---
/** The developer teaser (prompt §6, Home 6): the real snippet, one line on idempotency, two links. */
import Container from "@/components/site/Container.astro";
import Section from "@/components/site/Section.astro";
import Button from "@/components/ui/Button.astro";
import CodeBlock from "@/components/ui/CodeBlock.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import { APP } from "@/lib/site";

const SCRIPT_TAG = `<script
  src="https://go.refficks.com/refficks.js?a=rk_pub_…"
  data-account="rk_pub_…">
</script>`;
---

<Section tone="inverse" labelledBy="developer-heading">
  <Container>
    <div class="grid gap-10 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-6">
        <Eyebrow tone="inverse">For the developer you'll forward this to</Eyebrow>
        <h2 id="developer-heading" class="mt-4 text-heading-xl font-bold text-ink-inverse sm:text-display-md">
          One script tag. One idempotent POST.
        </h2>
        <p class="mt-4 text-body-lg text-ink-inverse-secondary">
          Send an event twice and the second answers 200 with status duplicate. Idempotency is a
          unique index in the database, not a check in code.
        </p>
        <p class="mt-3 text-body text-ink-inverse-secondary">
          OpenAPI 3.1, a Server API with no endpoint that approves or pays, signed webhooks, and an
          MCP server for Claude and ChatGPT.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <Button href="/developers/" variant="inverse" size="md">For developers</Button>
          <Button href={APP.apiReference} variant="inverse" size="md">Read the API reference</Button>
        </div>
      </div>
      <CodeBlock
        class="lg:col-span-6"
        label="The tracker, as a merchant pastes it"
        language="html"
        code={SCRIPT_TAG}
      />
    </div>
  </Container>
</Section>
