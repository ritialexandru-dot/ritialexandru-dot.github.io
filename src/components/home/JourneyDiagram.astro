---
/**
 * The eight-stage journey, purpose-drawn in the site palette (prompt §8):
 * eight tiles on the grid, each with the mark's one square corner, and the
 * three a dashboard sees set apart in the muted surface. No arrows: the
 * numbers carry the order at every width, and a row of arrows breaks the
 * moment the row wraps.
 *
 * Which three a reporting dashboard measures (the click, the conversion,
 * the commission) is a reading of the thesis (prompt §2) rather than a fact
 * ID, and the owner can move the marks.
 */
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;

const STAGES = ["Discover", "Recruit", "Onboard", "Activate", "Attribute", "Reward", "Grow", "Retain"];
const WATCHED = new Set(["Activate", "Attribute", "Reward"]);
---

<figure class={className}>
  <ol class="grid grid-cols-2 gap-2 sm:grid-cols-4 lg:grid-cols-8" aria-label="The eight stages of a partner's journey">
    {
      STAGES.map((stage, index) => (
        <li
          class:list={[
            "rounded-lg rounded-tl-xs border px-3 py-3 text-center",
            WATCHED.has(stage)
              ? "border-border-strong bg-subtle text-ink-secondary"
              : "border-border bg-surface text-ink",
          ]}
        >
          <span class="block text-label font-semibold text-ink-secondary" data-numeric>
            {index + 1}
          </span>
          <span class="block text-meta font-semibold">{stage}</span>
        </li>
      ))
    }
  </ol>
  <figcaption class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-1 text-caption text-ink-secondary">
    <span>Eight stages. Most tools report on three of them.</span>
    <span class="inline-flex items-center gap-1.5">
      <span aria-hidden="true" class="inline-block size-3 rounded-sm rounded-tl-xs border border-border-strong bg-subtle"></span>
      What a dashboard sees
    </span>
    <span class="inline-flex items-center gap-1.5">
      <span aria-hidden="true" class="inline-block size-3 rounded-sm rounded-tl-xs border border-border bg-surface"></span>
      What Refficks watches
    </span>
  </figcaption>
</figure>
