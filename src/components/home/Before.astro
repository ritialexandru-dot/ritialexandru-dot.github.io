---
/** The three questions before the button (Home 11). No price: the pricing page rule. */
import Container from "@/components/site/Container.astro";
import Section from "@/components/site/Section.astro";
import SectionHeading from "@/components/site/SectionHeading.astro";

const QUESTIONS = [
  {
    q: "What does it cost?",
    a: "30 days free from signup, everything included, no card until you subscribe. One trial per email address.",
  },
  {
    q: "Is it finished?",
    a: "It is early. Every screen on this page is real and in the app today. Whatever has not yet met a real provider says so, on its own page.",
  },
  {
    q: "Can I leave?",
    a: "Any time. The whole account comes out as CSV files in one archive, partners and customers can be erased, and a closed account is deleted after 90 days.",
  },
];
---

<Section tone="surface" labelledBy="before-heading">
  <Container>
    <SectionHeading id="before-heading" title="Three things people ask before they press the button" />
    <dl class="mt-10 grid gap-6 md:grid-cols-3">
      {
        QUESTIONS.map((item) => (
          <div class="rounded-lg border border-border bg-canvas p-6">
            <dt class="text-heading-md font-semibold text-ink">{item.q}</dt>
            <dd class="mt-2 text-body-sm text-ink-secondary">{item.a}</dd>
          </div>
        ))
      }
    </dl>
  </Container>
</Section>
