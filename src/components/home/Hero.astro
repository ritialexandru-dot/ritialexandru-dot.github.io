---
/**
 * The first viewport: a short headline, one sentence, the one call to
 * action, three reassurances, and the real Intelligence screen in a browser
 * frame on a forest panel carrying the mark's tile pattern (prompt §6,
 * Home 1; §7, the 5-second rule). The screen sits under the words at the
 * full column, so it is read rather than shrunk; phones get the single-card
 * crop of the same screen.
 */
import Container from "@/components/site/Container.astro";
import Section from "@/components/site/Section.astro";
import StartFree from "@/components/site/StartFree.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Frame from "@/components/ui/Frame.astro";
import Icon from "@/components/ui/Icon.astro";
import { SHOTS } from "@/lib/shots";

const REASSURANCES = ["30 days free", "Everything included", "Your data, out any time"];
---

<Section tone="canvas" padding="none" class="pt-12 pb-16 sm:pt-16 sm:pb-20 lg:pt-20 lg:pb-24">
  <Container>
    <div class="mx-auto flex max-w-3xl flex-col items-center text-center">
      <Eyebrow>Affiliate, referral, creator, ambassador and B2B programmes</Eyebrow>
      <h1 class="mt-5 text-display-md font-bold text-ink sm:text-display-lg xl:text-display-xl">
        Affiliate dashboards report. Refficks recommends.
      </h1>
      <p class="mt-5 max-w-2xl text-lead text-ink-secondary">
        Tracking, attribution, commissions and payouts in one place. Then, every morning, the
        partners who need you, with the evidence, and the decision left to you.
      </p>
      <StartFree
        class="mt-8"
        align="center"
        secondary={{ href: "/product/intelligence/", label: "See how it works" }}
      />
      <ul class="mt-6 flex flex-wrap justify-center gap-x-6 gap-y-2 text-meta text-ink-secondary">
        {
          REASSURANCES.map((item) => (
            <li class="inline-flex items-center gap-1.5">
              <Icon name="check" class="size-4 text-icon-brand" strokeWidth={2.25} />
              {item}
            </li>
          ))
        }
      </ul>
    </div>

    {/* The forest panel carries the mark's tile pattern at the edges, where the
        frame does not cover it, faintly: a brand moment behind the product
        rather than beside it. The caption sits outside, on the canvas, because
        the kit allows the pattern under no text smaller than 24px. */}
    <figure class="mt-12 lg:mt-16">
      <div class="relative overflow-hidden rounded-xl bg-inverse p-3 sm:p-6 lg:p-10">
        <div
          aria-hidden="true"
          class="absolute inset-0 opacity-40 bg-[url('/patterns/tiles-sparse.svg')] bg-[length:220px_220px]"
        >
        </div>
        <div class="relative">
          <Frame {...SHOTS.needsYou} narrow={SHOTS.needsYouCard} priority />
        </div>
      </div>
      <figcaption class="mt-4 text-center text-caption text-ink-secondary sm:text-meta">
        The Needs you list: ranked by what it costs you to ignore, with the evidence on every line.
      </figcaption>
    </figure>
  </Container>
</Section>
