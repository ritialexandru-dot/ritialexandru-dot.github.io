---
/** The four kinds of wasted partner (Home 7), and the rule under all of them. */
import Container from "@/components/site/Container.astro";
import Section from "@/components/site/Section.astro";
import SectionHeading from "@/components/site/SectionHeading.astro";
import StartFree from "@/components/site/StartFree.astro";
import Precisely from "@/components/ui/Precisely.astro";

const KINDS = [
  {
    title: "The one who never started.",
    body: "Approved weeks ago, link never placed. The dashboard shows nothing, because nothing happened, which is exactly the problem.",
    see: "“Approved 29 days ago and has not sent a single click.” The suggestion is the activation nudge, the one thing Autopilot may send on its own if you let it.",
  },
  {
    title: "The one sending traffic that never buys.",
    body: "Clicks arrive, sales don't. Either the audience is wrong or the page is, and a league table of sales will never show it.",
    see: "clicked but never sold, beside the median days other partners took from first click to first sale. The suggestion is a conversation.",
  },
  {
    title: "The one who went quiet.",
    body: "A good partner stops, and the total barely moves because the others cover it. Three months later it is a loss nobody dated.",
    see: "when they went dormant and what they used to send. The suggestion is to reach out before the silence becomes a habit.",
  },
  {
    title: "The one you're underpaying.",
    body: "Growing fast on a rate set before they were. A rate set before they grew is the kind of thing a good partner notices before you do.",
    see: "the raise it suggests and what it costs at the current run rate. Nothing changes until you confirm that exact number.",
  },
];
---

<Section tone="canvas" labelledBy="wasting-heading">
  <Container>
    <SectionHeading
      id="wasting-heading"
      title="Find the partners you're wasting. Every morning, with the evidence."
      lead="A wasted partner is not a bad one. It is one who could be earning for you and isn't, while the dashboard keeps counting the ones who are. Refficks looks for four kinds every night, and shows its reasoning on each."
    />

    <ul class="mt-10 grid gap-4 md:grid-cols-2">
      {
        KINDS.map((kind) => (
          <li class="rounded-lg border border-border bg-surface p-6">
            <h3 class="text-heading-lg font-semibold text-ink">{kind.title}</h3>
            <p class="mt-2 text-body-sm text-ink-secondary">{kind.body}</p>
            <Precisely label="What you see:" class="mt-4">
              {kind.see}
            </Precisely>
          </li>
        ))
      }
    </ul>

    <p class="mt-8 max-w-3xl text-body text-ink-secondary">
      Every one is ranked by what it costs you to ignore, and every one shows its evidence.
      &ldquo;Not now&rdquo; holds for 30 days, and a situation still true after that is raised
      again. Nothing on this list changes what anybody earns until you confirm it: no automation,
      no timer and no AI can act on it for you.
    </p>

    <StartFree class="mt-8" />
  </Container>
</Section>
